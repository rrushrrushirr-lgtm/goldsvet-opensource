{
    "name": "loshmis/vanguard",
    "description": "Goldsvet Laravel application runtime for EthioDeploy",
    "type": "project",
    "repositories": [],
    "require": {
        "php": "~8.2.0",
        "anlutro/l4-settings": "^1.0",
        "bacon/bacon-qr-code": "^2.0",
        "barryvdh/laravel-debugbar": "^3.7.0",
        "geoip2/geoip2": "^2.11",
        "guzzlehttp/guzzle": "^7.5",
        "hexters/coinpayment": "^3.0",
        "intervention/image": "^2.3",
        "jenssegers/agent": "^2.6.4",
        "jeremykenedy/laravel-roles": "9.*",
        "laracasts/presenter": "^0.2.5",
        "laravel/framework": "9.x",
        "laravel/legacy-factories": "^1.3.0",
        "laravel/sanctum": "^3.0",
        "laravel/tinker": "^2.0",
        "laravelcollective/html": "^6.3.0",
        "league/fractal": "^0.20.1",
        "mobiledetect/mobiledetectlib": "^2.0|^3.74",
        "paragonie/random_compat": "^2.0.21",
        "php-open-source-saver/jwt-auth": "2.*",
        "pragmarx/google2fa-laravel": "^2.0.2",
        "predis/predis": "^2.0.3",
        "proengsoft/laravel-jsvalidation": "^4.7.6",
        "spatie/db-dumper": "^3.3.0",
        "yajra/laravel-datatables-oracle": "^10.2.1"
    },
    "autoload": {
        "classmap": ["casino/database/seeds", "casino/database/factories"],
        "psr-4": {"VanguardLTE\\": "casino/app/"},
        "files": ["casino/app/Support/helpers.php"]
    },
    "extra": {"laravel": {"dont-discover": []}},
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php casino/artisan package:discover"
        ]
    },
    "config": {
        "vendor-dir": "casino/vendor",
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {"php-http/discovery": true},
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-b41t-wbzk-9q51",
                    "PKSA-d5tc-s1qs-h781",
                    "PKSA-3r5d-mb8f-1qw9",
                    "PKSA-m5cs-t1y6-qpcs",
                    "PKSA-mdq4-51ck-6kdq",
                    "PKSA-8qx3-n5y5-vvnd",
                    "PKSA-w7xr-vk7n-rstm"
                ]
            }
        }
    }
}